# ANASTASIA 4.3.1 — SAFE TEST. Default is locked-down.
# Keep true until account provenance and SMS number ownership are clarified.
SAFE_TEST_MODE=true
# Creates a NEW local Telethon login in data/sessions/. Never import seller TData/Auth Key.
TG_SESSION_NAME=anastasia_own_login

# Telegram Client API: https://my.telegram.org
TG_API_ID=
TG_API_HASH=
TG_PHONE=
# Separate Telegram account for Anastasia Vladimirovna, never your private one.
# Set the display name in Telegram settings; this setting also sets the name in the messages.
AGENT_NAME=Анастасия Владимировна
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Legacy CSV outbound v2 is disabled in v3 regardless of this setting.
OUTREACH_ENABLED=false
DRY_RUN=true
DAILY_LIMIT=10
SEND_INTERVAL_SECONDS=120
OUTREACH_POLL_MINUTES=60
AUTO_DISCOVER_GROUPS=false
# Each daily run processes a rotating batch of public-community search phrases (1-12).
CITY_RADAR_QUERIES_PER_RUN=8
# AlfaCRM details. Keep secrets in .env only, never send them in chat.
ALFACRM_ALEX_URL=
ALFACRM_ALEX_EMAIL=
ALFACRM_ALEX_API_KEY=
ALFACRM_ALEX_BRANCH=
ALFACRM_ALEX_LEAD_SOURCE=
ALFACRM_YARO_URL=
ALFACRM_YARO_EMAIL=
ALFACRM_YARO_API_KEY=
ALFACRM_YARO_BRANCH=
ALFACRM_YARO_LEAD_SOURCE=

# FAMILY RADAR v3. Disabled until a real privacy-policy page is configured.
FAMILY_RADAR_ENABLED=false
# Link to your real published policy (not the homepage); must start with https://
PRIVACY_POLICY_URL=
# Campaign follow-up ONLY for families who explicitly subscribed in a private chat.
FAMILY_RADAR_OUTREACH_ENABLED=false

# AUTO JOIN 4.3: only PUBLIC communities that are local and in the catalog.
# Two safeguards: owner sends /автовступление вкл, and this .env master toggle.
AUTO_JOIN_ENABLED=false
# Keep true for the initial test; set false only when you are ready to join for real.
AUTO_JOIN_DRY_RUN=true
AUTO_JOIN_DAILY_LIMIT=3
AUTO_JOIN_MAX_TOTAL=70
AUTO_JOIN_PAUSE_SECONDS=180
AUTO_JOIN_POLL_MINUTES=240

# DIRECTOR ORDERS 4.4 — two equal administrators.
# Both PERSONAL Telegram accounts must be pinned using their numeric IDs.
# Each of you send /мой_id to the Anastasia account to obtain the numeric ID.
# Do not use @username: usernames and display names can change or be imitated.
# No director command can run until BOTH fields are populated with distinct IDs.
ADMIN_OWNER_TG_ID=
ADMIN_WIFE_TG_ID=
# Optional; defaults to OPENAI_MODEL.
DIRECTOR_MODEL=gpt-5-mini
VOICE_TRANSCRIPTION_MODEL=whisper-1

# 4.5 integrations remain off until configured
CRM_ENABLED=false
REMINDERS_ENABLED=false
HISTORY_DAYS=30
# Set current model-specific USD prices; blank means cost is unknown
API_INPUT_USD_PER_MILLION=
API_OUTPUT_USD_PER_MILLION=
# Optional exact per-model input/output prices in USD per million tokens.
# Empty means unknown. Scalar prices above apply only to OPENAI_MODEL.
API_PRICES_JSON={}

# Conversation behavior 4.22. Allowed values and precedence: README_4_22.md.
ANASTASIA_FORMALITY=neutral
ANASTASIA_WARMTH=warm
ANASTASIA_HUMOR_LEVEL=light
ANASTASIA_VERBOSITY=standard
ANASTASIA_INITIATIVE=balanced
ANASTASIA_EMOJI_FREQUENCY=rare
ANASTASIA_CONVERSATION_STYLE=natural

# Local admin panel: python admin_panel.py (127.0.0.1:8765 only).
# Uses the same .env and ADMIN_OWNER_TG_ID / ADMIN_WIFE_TG_ID.
# Issue a one-time login code: python admin_panel.py --login-code YOUR_NUMERIC_ID
# Alternatively send /панель from either pinned personal Telegram account.
# Additional allowed response languages; ru always remains available.
AGENT_LANGUAGES=ru,en

# Business volume limit (UTC day), NOT a Telegram safe threshold.
INITIAL_DAILY_LIMIT=3
