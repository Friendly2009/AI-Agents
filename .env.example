# Copy to .env and replace token; python -m market_agent init does this automatically.
# Token must be random, at least 32 characters. Never put it in dashboard source code.
API_TOKEN=CHANGE_ME_GENERATE_A_RANDOM_TOKEN
MODE=demo
DATABASE_PATH=data/agent.sqlite3
MARKETS_FILE=markets.example.json
TIMEZONE=Europe/Moscow
# 0 = Monday; analysis runs at 09:00 in TIMEZONE.
SCHEDULE_ENABLED=true
SCHEDULE_WEEKDAY=0
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
# If startup is later in the same week, run the missed report once.
SCHEDULE_CATCHUP=true
NEWS_LOOKBACK_DAYS=7
HTTP_TIMEOUT_SECONDS=20
HTTP_RETRIES=2

# Optional AI. Set all four values to enable; otherwise a factual report is produced.
LLM_ENABLED=false
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
# Supply an available model ID from your provider; no model is selected automatically.
LLM_MODEL=
# Allowed browser origins for a separate dashboard (JSON array). Same-origin UI needs none.
CORS_ORIGINS=[]
